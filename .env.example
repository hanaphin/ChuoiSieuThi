# Cấu hình kết nối CSDL Oracle 23ai Multitenant
PORT=3000

# CDB Root Connection (Dùng cho Common User & Báo cáo Cross-PDB)
ORACLE_CDB_HOST=localhost
ORACLE_CDB_PORT=1521
ORACLE_CDB_SERVICE=FREE
ORACLE_COMMON_USER=c##admin_chuoi
ORACLE_COMMON_PASSWORD=SuperAdmin2026#

# Cấu hình kết nối từng PDB (Chi nhánh siêu thị)
# PDB 1: Siêu thị Quận 1
PDB1_SERVICE=pdb_quan1
PDB1_USER=local_q1
PDB1_PASSWORD=Q1Pass2026#

# PDB 2: Siêu thị Quận 7
PDB2_SERVICE=pdb_quan7
PDB2_USER=local_q7
PDB2_PASSWORD=Q7Pass2026#

# PDB 3: Siêu thị Thủ Đức
PDB3_SERVICE=pdb_thuduc
PDB3_USER=local_td
PDB3_PASSWORD=TDPass2026#

# Chế độ chạy: 'ORACLE' (nối DB thật) hoặc 'DEMO_MOCK' (mô phỏng dữ liệu Multitenant khi chưa bật Oracle)
APP_MODE=DEMO_MOCK
